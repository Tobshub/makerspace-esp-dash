# Local development defaults. Copy to .env and adjust.
# Do not commit .env or real secrets.

HTTP_ADDR=:8080

DATABASE_URL=postgres://makerspace:makerspace@localhost:5432/makerspace?sslmode=disable

MQTT_BROKER_URL=tcp://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Hostname and port shown to devices. Empty uses MQTT_BROKER_URL.
# The Coolify stack defaults the hostname to the web console domain.
MQTT_PUBLIC_HOST=
MQTT_PUBLIC_PORT=

DEVICE_OFFLINE_TIMEOUT_SECONDS=60
COMMAND_TIMEOUT_SECONDS=30
MQTT_MAX_PAYLOAD_BYTES=16384
MQTT_MAX_METRICS=50
MQTT_MAX_KEY_LENGTH=64
MQTT_MAX_STRING_LENGTH=1024
MQTT_TELEMETRY_PER_SECOND=10

APP_URL=http://localhost:5173
API_URL=http://localhost:8080

TELEMETRY_RETENTION_DAYS=90
DEVICE_EVENT_RETENTION_DAYS=30
